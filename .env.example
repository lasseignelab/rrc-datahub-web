# Copy this file to .env and fill in the values. Never commit .env.

# Set to true to enable SQL query logging (development only — omit or set false in production)
DEBUG=true

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rrc_datahub
DB_USER=rrc_user
DB_PASSWORD=yourpassword

# OpenAI API key for the home-page data chat. Get one at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: model for the data chat (default gpt-5.4-mini)
OPENAI_MODEL=

# GitHub personal access token — needs repo read scope for lasseignelab/rrc-datahub
GITHUB_TOKEN=

# UAB Cheaha SSH connection (password prompted at runtime — not stored here)
CHEAHA_HOST=cheaha.rc.uab.edu
CHEAHA_USER=
CHEAHA_BASE_PATH=/data/project/lasseigne_lab/DATASET_dir/rrc-datahub/nfcore_rnaseq

# Local staging directory for downloaded files (default: staging/)
STAGING_DIR=staging
