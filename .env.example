# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rrc_datahub
DB_USER=rrc_datahub
DB_PASSWORD=choose_a_password

# GitHub personal access token — needs repo read scope for lasseignelab/rrc-datahub
GITHUB_TOKEN=

# UAB Cheaha SSH connection (password prompted at runtime — not stored here)
CHEAHA_HOST=cheaha.rc.uab.edu
CHEAHA_USER=
CHEAHA_BASE_PATH=/data/project/lasseigne_lab/DATASET_dir/rrc-datahub/nfcore_rnaseq

# Local staging directory for downloaded files (default: staging/)
STAGING_DIR=staging
